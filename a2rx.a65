    .proc main

soh     := $01      # ASCII 'SOH' character
eot     := $04      # ASCII 'EOT' character
ack     := $06      # ASCII 'ACK' character
nak     := $15      # ASCII 'NAK' character
can     := $18      # ASCII 'CAN' character

warmstart   := $03D0    # DOS warmstart return to BASIC
coldstart   := $03D3    # DOS coldstart clear program and return to BASIC

buffer  := $0900    # 256 byte input buffer, part 1
buffer2  := $0980    # 256 byte input buffer, part 2

tdreg   := $C0A8    # transmit register for slot 2
rdreg   := $C0A8    # receive register for slot 2
streg   := $C0A9    # status register for slot 2
cmdreg  := $C0AA    # command register for slot 2
ctlreg  := $C0AB    # control register for slot 2


    LDA   #$0B
    STA   cmdreg
    LDA   #$1F
    STA   $CMDREG
    LDA   #nak
    JSR   sendbyte
    JSR   recvbyte
    CMP   #soh
    BEQ   sohreceived1
    BRK
sohreceived1:
    JSR   recvbyte
    CMP   #$01
    BEQ   block1idreceived
    BRK
block1idreceived:
    JSR   recvbyte
    CMP   #$FE
    BEQ   block1idchecksumreceived
    BRK
block1idchecksumreceived:
    LDX   #$00
readdatabyte:
    JSR   recvbyte
    STA   buffer,X
    INX
    BPL   readdatabyte
    JSR   recvbyte  # receive (and ignore!) checksum
    LDA   #ack
    JSR   sendbyte
    JSR   readbyte
    CMP   #soh
    BEQ   sohreceived2
    BRK
sohreceived2:
    JSR   readbyte
    CMP   #$02
    BEQ   block2idreceived
    BRK
block2idreceived:
    JSR   readbyte
    CMP   #$FD
    BEQ   block2idchecksumreceived
    BRK
block2idchecksumreceived:
    LDX   #$00
readdatabyte2:
    JSR   readbyte
    STA   buffer2,X
    INX
    BPL   readdatabyte2
    JSR   readbyte  # receive (and ignore!) checksum
    LDA   #ack
    JSR   sendbyte
    JSR   readbyte
    CMP   #eot
    BEQ   eotreceived
    BRK
eotreceived:
    LDA   #ack
    JSR   sendbyte
    JMP   coldstart


sendbyte:
    PHA
waitforreadytosend:
    LDA   streg
    AND   #$70
    CMP   #$10
    BNE   waitforreadytosend
    PLA
    LDY   #$A9
    STA   $BFFF,Y   # magic to ensure no read before write
    RTS

recvbyte:
    LDA   streg
    AND   #$08
    BEQ   recvbyte
    LDA   rdreg
    RTS
